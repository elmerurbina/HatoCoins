---
import { CATEGORIES, HISTORY_VISIBLE } from '../../lib/config';

/**
 * InvestmentHistory — feed compacto de las últimas inversiones.
 * No es protagonista: vive en una esquina del HUD.
 */
const placeholders = Array.from({ length: HISTORY_VISIBLE }, (_, i) => ({
  key: `ph-${i}`,
  emoji: CATEGORIES[i % CATEGORIES.length]?.emoji ?? '🪙',
  amountLabel: '—',
  timeLabel: '--:--',
}));
---

<section class="feed hud-panel" data-history aria-label="Últimas inversiones">
  <header class="feed__head">
    <h3 class="hud-label">ÚLTIMAS INVERSIONES</h3>
  </header>

  <ul class="feed__list" data-history-list>
    {
      placeholders.map((ph) => (
        <li class="feed__row is-empty" data-history-key={ph.key}>
          <span class="feed__emoji" aria-hidden="true">
            {ph.emoji}
          </span>
          <span class="feed__amount">{ph.amountLabel}</span>
          <span class="feed__time">{ph.timeLabel}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .feed {
    display: grid;
    gap: 12px;
    padding: 18px 20px 16px;
  }

  .feed__head h3 {
    margin: 0;
    color: var(--color-hm-ink-300);
  }

  .feed__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 7px;
    min-height: 196px;
    align-content: start;
  }

  .feed__row {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 7px 12px 7px 10px;
    border-radius: 12px;
    background: rgb(10 20 17 / 0.55);
    border: 1px solid rgb(139 161 147 / 0.1);
    animation: hm-rise 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .feed__row.is-empty {
    opacity: 0.28;
  }

  .feed__emoji {
    font-size: 17px;
    line-height: 1;
  }

  .feed__amount {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    color: var(--color-hm-gold-200);
  }

  .feed__time {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-hm-ink-400);
  }

  .feed__row:first-child .feed__amount {
    color: var(--color-hm-gold-100);
  }
</style>
