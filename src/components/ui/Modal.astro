---
export interface Props {
  open?: boolean;
  labelledBy?: string;
  class?: string;
}

const { labelledBy, class: className = '' } = Astro.props;
---

<div class:list={['scrim', className]} data-modal data-open="false" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby={labelledBy}>
  <div class="modal-card">
    <slot />
  </div>
</div>

<style>
  .scrim .modal-card {
    transform: translateY(26px) scale(0.94);
    opacity: 0;
    transition:
      transform 320ms cubic-bezier(0.22, 1.2, 0.36, 1),
      opacity 240ms ease;
  }

  .scrim[data-open='true'] .modal-card {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
</style>
