---
---

<div class="rifa-machine">
  <div class="rifa-machine__glass">
    <span class="rifa-machine__scan" aria-hidden="true"></span>
    <span class="rifa-machine__glare" aria-hidden="true"></span>

    <div class="rifa-machine__readout" data-slot>
      <span class="rifa-machine__icon" data-slot-icon aria-hidden="true">🍼</span>
      <span class="rifa-machine__text" data-slot-text role="status" aria-live="polite">
        LISTO PARA ORDEÑAR
      </span>
    </div>

    <div class="rifa-machine__reels" aria-hidden="true">
      <span class="rifa-machine__reel" data-reel="0">·</span>
      <span class="rifa-machine__reel" data-reel="1">·</span>
      <span class="rifa-machine__reel" data-reel="2">·</span>
    </div>
  </div>
</div>

<style>
  .rifa-machine {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    width: 100%;
    min-width: 0;
  }

  .rifa-machine__glass {
    position: relative;
    width: 100%;
    max-width: 460px;
    min-width: 0;
    padding: 12px;
    border-radius: 20px;
    overflow: hidden;
    background:
      linear-gradient(170deg, rgb(15 50 72 / 0.95) 0%, rgb(7 26 18 / 0.98) 100%);
    border: 2px solid rgb(234 191 78 / 0.28);
    box-shadow:
      inset 0 1px 0 0 rgb(253 245 218 / 0.12),
      0 0 40px -12px rgb(216 160 41 / 0.32),
      0 20px 50px -22px rgb(0 0 0 / 0.9);
  }

  /* Líneas de CRT */
  .rifa-machine__scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 3px,
      rgb(234 191 78 / 0.035) 3px 5px
    );
    pointer-events: none;
  }

  /* Barrido de luz */
  .rifa-machine__glare {
    position: absolute;
    top: -10%;
    left: -40%;
    width: 30%;
    height: 120%;
    background: linear-gradient(100deg, transparent, rgb(216 232 224 / 0.12), transparent);
    transform: skewX(-18deg);
    animation: machine-glare 5.5s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    pointer-events: none;
  }

  .rifa-machine__readout {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    overflow: hidden;
    padding: 8px 12px;
    margin-bottom: 10px;
    border-radius: 12px;
    background: rgb(4 12 9 / 0.68);
    border: 1px solid rgb(234 191 78 / 0.2);
  }
  .rifa-machine__icon {
    flex: none;
    font-size: 24px;
    line-height: 1;
    animation: hm-bob 2.4s ease-in-out infinite;
  }
  .rifa-machine__text {
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(13px, 3vw, 18px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-hm-gold-300);
    text-shadow: 0 0 14px rgb(216 160 41 / 0.5);
    overflow-wrap: anywhere;
  }

  .rifa-machine__reels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .rifa-machine__reel {
    display: grid;
    place-items: center;
    min-width: 0;
    height: clamp(52px, 15vw, 78px);
    border-radius: 12px;
    font-size: clamp(20px, 6vw, 28px);
    line-height: 1;
    color: var(--color-hm-ink-400);
    background: linear-gradient(180deg, #0a1411 0%, #050f0c 100%);
    border: 1px solid rgb(139 161 147 / 0.2);
    box-shadow: inset 0 6px 14px -8px rgb(0 0 0 / 0.9);
    transition: color 200ms ease, border-color 200ms ease, box-shadow 300ms ease;
  }

  /* Girando: parpadeo rápido + vibración */
  .rifa-machine__reel.is-spinning {
    color: var(--color-hm-gold-200);
    border-color: rgb(234 191 78 / 0.55);
    box-shadow: inset 0 6px 14px -8px rgb(0 0 0 / 0.9), 0 0 18px -4px rgb(216 160 41 / 0.6);
    animation: reel-blur 90ms steps(2, end) infinite;
  }

  .rifa-machine__reel.is-locked {
    color: var(--color-hm-gold-300);
    border-color: rgb(234 191 78 / 0.7);
    animation: reel-lock 320ms cubic-bezier(0.22, 1.4, 0.36, 1) both;
  }

  .rifa-machine__reel.has-winner {
    color: var(--prize-color, var(--color-hm-gold-100));
    border-color: var(--prize-color, var(--color-hm-gold-400));
    box-shadow:
      inset 0 0 20px -6px var(--prize-color, rgb(216 160 41 / 0.6)),
      0 0 30px -6px var(--prize-color, rgb(216 160 41 / 0.6));
    animation: hm-pop-in 420ms cubic-bezier(0.22, 1.35, 0.36, 1) both;
  }

  @keyframes machine-glare {
    0%, 62% { left: -40%; }
    100% { left: 130%; }
  }
  @keyframes reel-blur {
    0% { transform: translateY(-1.5px) scaleY(1.03); }
    100% { transform: translateY(1.5px) scaleY(0.97); }
  }
  @keyframes reel-lock {
    0% { transform: scale(1.14); }
    60% { transform: scale(0.95); }
    100% { transform: scale(1); }
  }
</style>
