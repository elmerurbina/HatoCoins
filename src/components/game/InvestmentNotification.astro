---
/**
 * InvestmentNotification — aviso de recompensa tras invertir.
 * El controlador escribe `data-notification-open` y los textos.
 */
---

<div class="notify" data-notification aria-live="polite" aria-atomic="true">
  <div class="notify__card">
    <span class="notify__emoji" data-notification-emoji>🪙</span>
    <div class="notify__text">
      <p class="notify__title" data-notification-title>¡BRISSA RECIBIÓ 0 HatoCoins!</p>
      <p class="notify__sub" data-notification-sub>Tu inversión alimentará a Brissa.</p>
    </div>
  </div>
</div>

<style>
  .notify {
    position: absolute;
    left: 50%;
    bottom: 404px;
    z-index: 44;
    translate: -50% 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 220ms ease,
      visibility 220ms step-end;
  }

  .notify[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 220ms ease,
      visibility 0ms step-start;
  }

  .notify[data-open='true'] .notify__card {
    animation: hm-toast-in 620ms cubic-bezier(0.22, 1.3, 0.36, 1) both;
  }

  .notify__card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 40px 20px 26px;
    border-radius: 999px;
    background: linear-gradient(
      100deg,
      rgb(24 42 36 / 0.96) 0%,
      rgb(11 35 24 / 0.94) 48%,
      rgb(42 29 16 / 0.96) 100%
    );
    border: 2px solid rgb(234 191 78 / 0.5);
    box-shadow:
      inset 0 1px 0 0 rgb(253 245 218 / 0.25),
      0 0 0 8px rgb(216 160 41 / 0.08),
      0 22px 50px -20px rgb(0 0 0 / 0.95),
      0 0 60px -18px rgb(216 160 41 / 0.7);
  }

  .notify[data-tone='goal'] .notify__card {
    border-color: rgb(69 167 95 / 0.75);
    background: linear-gradient(
      100deg,
      rgb(16 52 32 / 0.96) 0%,
      rgb(11 35 24 / 0.94) 52%,
      rgb(29 99 57 / 0.96) 100%
    );
    box-shadow:
      inset 0 1px 0 0 rgb(233 245 236 / 0.25),
      0 0 0 8px rgb(69 167 95 / 0.12),
      0 22px 50px -20px rgb(0 0 0 / 0.95),
      0 0 70px -14px rgb(69 167 95 / 0.85);
  }

  .notify__emoji {
    font-size: 44px;
    line-height: 1;
    filter: drop-shadow(0 0 18px rgb(216 160 41 / 0.6));
  }

  .notify__text {
    display: grid;
    gap: 4px;
  }

  .notify__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 30px;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-hm-gold-100);
    text-shadow: 0 0 26px rgb(216 160 41 / 0.45);
    white-space: nowrap;
  }

  .notify__sub {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-hm-ink-300);
  }
</style>
