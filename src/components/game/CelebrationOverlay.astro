---
/**
 * CelebrationOverlay — celebración de cada meta alcanzada.
 * Canvas para el confeti (barato, sin miles de nodos DOM) + cartel central.
 *
 * Las metas no tienen techo: al cruzar una, el servidor sube la siguiente, así
 * que el cartel anuncia la recién alcanzada y cuál es la siguiente.
 */
---

<div class="celebration" data-celebration aria-hidden="true">
  <canvas class="celebration__canvas" data-confetti width="1920" height="1080"></canvas>
  <div class="celebration__card">
    <p class="celebration__kicker" data-celebration-kicker>META COLECTIVA ALCANZADA</p>
    <h3 class="celebration__title">🎉 ¡BRISSA ESTÁ ALIMENTADA!</h3>
    <p class="celebration__figures">
      <span class="celebration__total" data-celebration-total>0</span>
      <span class="celebration__goal" data-celebration-goal>de 100,000 HM</span>
    </p>
    <p class="celebration__sub" data-celebration-sub>Cada inversión alimenta una idea.</p>
  </div>
</div>

<style>
  .celebration {
    position: absolute;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 320ms ease,
      visibility 320ms step-end;
  }

  .celebration[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 320ms ease,
      visibility 0ms step-start;
  }

  .celebration__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .celebration__card {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 46px 78px 54px;
    border-radius: 34px;
    text-align: center;
    background: linear-gradient(
      170deg,
      rgb(16 52 32 / 0.94) 0%,
      rgb(7 26 18 / 0.96) 52%,
      rgb(42 29 16 / 0.96) 100%
    );
    border: 2px solid rgb(69 167 95 / 0.55);
    box-shadow:
      inset 0 2px 0 0 rgb(233 245 236 / 0.16),
      0 0 0 10px rgb(69 167 95 / 0.08),
      0 40px 90px -30px rgb(0 0 0 / 0.95),
      0 0 120px -20px rgb(69 167 95 / 0.7);
  }

  .celebration[data-open='true'] .celebration__card {
    animation: hm-pop-in 560ms cubic-bezier(0.22, 1.3, 0.36, 1) both;
  }

  .celebration__kicker {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--color-hm-ink-300);
  }

  .celebration__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 62px;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    background: linear-gradient(
      178deg,
      var(--color-hm-gold-100) 0%,
      var(--color-hm-gold-300) 46%,
      var(--color-hm-gold-600) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 40px rgb(216 160 41 / 0.55));
  }

  .celebration__figures {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .celebration__total {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 56px;
    color: var(--color-hm-green-100);
    font-variant-numeric: tabular-nums;
  }

  .celebration__goal {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    color: var(--color-hm-ink-300);
  }

  .celebration__sub {
    margin: 4px 0 0;
    font-size: 19px;
    font-style: italic;
    font-weight: 500;
    color: var(--color-hm-ink-200);
  }
</style>
