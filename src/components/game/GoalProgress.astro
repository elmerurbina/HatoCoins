---
/**
 * GoalProgress — HUD central: mensaje, contador, barra y porcentaje.
 * Horizontal (estilo panel de juego) para dejar altura vertical al comedero.
 * El controlador escribe los valores en runtime (contador interpolado).
 */
---

<section class="goal hud-panel hud-corners" data-goal data-tone="calm" aria-label="Progreso de la meta">
  <div class="goal__row">
    <p class="goal__message" data-goal-message>Brissa está esperando...</p>

    <div class="goal__figures">
      <span class="goal__total hud-value" data-goal-total>0</span>
      <span class="goal__sep" aria-hidden="true">/</span>
      <span class="goal__goal" data-goal-target>10,000</span>
      <span class="goal__unit">HM</span>
    </div>

    <div class="goal__pct">
      <span class="goal__percent" data-goal-percent>0%</span>
    </div>
  </div>

  <div
    class="goal__bar"
    data-goal-bar
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    aria-label="Progreso de HatoCoins"
  >
    <div class="goal__bar-fill" data-goal-fill></div>
    <div class="goal__bar-sheen" aria-hidden="true"></div>
    <div class="goal__ticks" aria-hidden="true">
      {
        Array.from({ length: 19 }, (_, i) => (
          <span class:list={['goal__tick', i % 2 === 0 && 'goal__tick--major']} style={`left:${(i / 18) * 100}%`} />
        ))
      }
    </div>
  </div>

  <div class="goal__foot">
    <span class="goal__meta" data-goal-remaining>FALTAN 10,000</span>
    <span class="goal__overflow" data-goal-overflow hidden>🎉 ¡META SUPERADA!</span>
    <span class="goal__goal-label">META COLECTIVA · 10,000 HatoCoins</span>
  </div>
</section>

<style>
  .goal {
    display: grid;
    gap: 9px;
    padding: 13px 22px 14px;
    width: 100%;
  }

  .goal__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
  }

  .goal__message {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 23px;
    letter-spacing: 0.005em;
    color: var(--color-hm-gold-300);
    text-shadow: 0 0 24px rgb(216 160 41 / 0.35);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .goal[data-tone='fire'] .goal__message {
    color: var(--color-hm-gold-200);
    animation: hm-pulse-glow 1.4s ease-in-out infinite;
  }

  .goal[data-tone='goal'] .goal__message {
    color: var(--color-hm-green-200);
  }

  .goal__figures {
    display: flex;
    align-items: baseline;
    gap: 9px;
    line-height: 1;
  }

  .goal__total {
    font-size: 50px;
    transform-origin: 50% 70%;
    will-change: transform;
    color: var(--color-hm-green-50);
    text-shadow:
      0 0 34px rgb(69 167 95 / 0.5),
      0 3px 0 rgb(4 18 13 / 0.7);
  }

  .goal__sep {
    font-size: 28px;
    font-weight: 300;
    color: var(--color-hm-ink-400);
  }

  .goal__goal {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 30px;
    color: var(--color-hm-ink-200);
    font-variant-numeric: tabular-nums;
  }

  .goal__unit {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: 0.12em;
    color: var(--color-hm-gold-400);
  }

  .goal__pct {
    justify-self: end;
  }

  .goal__percent {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 30px;
    color: var(--color-hm-green-200);
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 22px rgb(69 167 95 / 0.45);
  }

  .goal__bar {
    position: relative;
    height: 28px;
    border-radius: 999px;
    overflow: hidden;
    background: linear-gradient(180deg, #04120d 0%, #071a12 100%);
    border: 1px solid rgb(139 161 147 / 0.22);
    box-shadow:
      inset 0 3px 8px 0 rgb(0 0 0 / 0.85),
      0 0 0 1px rgb(0 0 0 / 0.5);
  }

  .goal__bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(180deg, #eabf4e 0%, #d6a029 18%, #2a8248 44%, #45a75f 72%, #7fca8d 100%);
    box-shadow:
      0 0 20px rgb(69 167 95 / 0.75),
      inset 0 2px 0 0 rgb(253 245 218 / 0.4);
  }

  .goal__bar-sheen {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 30%;
    background: linear-gradient(90deg, transparent, rgb(253 245 218 / 0.24), transparent);
    animation: hm-goal-scan 3.2s linear infinite;
    pointer-events: none;
  }

  .goal__ticks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .goal__tick {
    position: absolute;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: rgb(4 18 13 / 0.35);
  }

  .goal__tick--major {
    top: 3px;
    bottom: 3px;
    width: 2px;
    background: rgb(4 18 13 / 0.5);
  }

  .goal__foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 14px;
  }

  .goal__meta,
  .goal__goal-label {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-hm-ink-400);
    white-space: nowrap;
  }

  .goal__meta {
    color: var(--color-hm-green-200);
  }

  .goal__goal-label {
    text-align: right;
  }

  .goal__overflow {
    padding: 5px 18px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-hm-green-100);
    background: linear-gradient(180deg, rgb(45 163 95 / 0.4), rgb(16 52 32 / 0.7));
    border: 1px solid rgb(69 167 95 / 0.6);
    box-shadow: 0 0 26px -8px rgb(69 167 95 / 0.9);
    animation: hm-pulse-glow 1.6s ease-in-out infinite;
  }

  .goal__overflow[hidden] {
    display: none;
  }
</style>

<style is:global>
  @keyframes hm-goal-scan {
    0% {
      transform: translateX(-140%);
    }
    100% {
      transform: translateX(430%);
    }
  }
</style>
