---
/**
 * CoinAnimation — capa de efectos visuales de la inversión.
 *
 * Este componente NO crea las monedas: monta las capas vacías donde el motor
 * (`src/lib/animations.ts`) inyecta, en tiempo de ejecución, las HatoCoins, los
 * granos de alimento y las chispas. Al ser nodos creados en runtime, los estilos
 * viven en un bloque `is:global` para que el scope de Astro no los recorte.
 */
---

<div class="hm-fx" data-fx-root aria-hidden="true">
  <div class="hm-fx__layer hm-fx__layer--flash" data-fx-layer="flash"></div>
  <div class="hm-fx__layer hm-fx__layer--sparks" data-fx-layer="sparks"></div>
  <div class="hm-fx__layer hm-fx__layer--grains" data-fx-layer="grains"></div>
  <div class="hm-fx__layer hm-fx__layer--coins" data-fx-layer="coins"></div>
  <div class="hm-fx__layer hm-fx__layer--badge" data-fx-layer="badge"></div>
</div>

<style is:global>
  /* ── Contenedor de efectos: ignora punteros ───────────────────────── */
  .hm-fx {
    position: absolute;
    inset: 0;
    z-index: 40;
    pointer-events: none;
    overflow: hidden;
  }

  .hm-fx__layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* ── FASE 1 · Insignia de importe ───────────────────────────────────── */
  /* Columna flexible centrada como grupo: con `grid`, las filas `auto` se
     estiran y el importe acababa a ~540 px de su etiqueta de categoría. */
  .hm-fx__layer--badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .hm-fx__layer--badge > * {
    opacity: 0;
  }

  .hm-fx__layer--badge.is-live .hm-badge__amount {
    display: inline-block;
    padding: 18px 44px 22px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 84px;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--color-hm-gold-100);
    background:
      linear-gradient(180deg, rgb(107 71 16 / 0.96) 0%, rgb(42 29 16 / 0.96) 62%, rgb(23 15 9 / 0.98) 100%);
    border: 2px solid rgb(234 191 78 / 0.75);
    box-shadow:
      inset 0 2px 0 0 rgb(251 233 180 / 0.32),
      inset 0 -3px 0 0 rgb(4 18 13 / 0.6),
      0 0 0 8px rgb(216 160 41 / 0.1),
      0 26px 60px -20px rgb(0 0 0 / 0.9),
      0 0 70px -14px rgb(216 160 41 / 0.6);
    animation: hm-badge-in 620ms cubic-bezier(0.22, 1.35, 0.36, 1) both;
    text-shadow:
      0 2px 0 rgb(74 48 8 / 0.8),
      0 0 30px rgb(216 160 41 / 0.55);
  }

  .hm-fx__layer--badge .hm-badge__unit {
    font-size: 0.52em;
    letter-spacing: 0.16em;
    opacity: 0.82;
  }

  .hm-fx__layer--badge .hm-badge__tag {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 30px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-hm-ink-100);
    text-align: center;
    text-shadow: 0 2px 10px rgb(0 0 0 / 0.9);
  }

  .hm-fx__layer--badge.is-live .hm-badge__tag {
    animation: hm-float-in 520ms 180ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* ── FASE 2 · HatoCoin ─────────────────────────────────────────────── */
  .hm-coin {
    position: absolute;
    width: 46px;
    height: 46px;
    margin: -23px 0 0 -23px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    will-change: transform, opacity;
    background:
      radial-gradient(60% 60% at 34% 26%, var(--color-hm-gold-200) 0%, var(--color-hm-gold-400) 34%, var(--color-hm-gold-600) 68%, var(--color-hm-gold-800) 100%);
    border: 2px solid rgb(251 233 180 / 0.85);
    box-shadow:
      inset 0 -3px 6px 0 rgb(74 48 8 / 0.6),
      inset 0 3px 5px 0 rgb(255 245 218 / 0.55),
      0 6px 16px -6px rgb(180 120 20 / 0.9),
      0 0 22px -4px rgb(216 160 41 / 0.75);
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.55));
  }

  .hm-coin__face {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 22px;
    line-height: 1;
    color: rgb(74 48 8 / 0.9);
    text-shadow: 0 1px 0 rgb(255 245 218 / 0.6);
  }

  /* ── FASE 3/4 · Granos de alimento ─────────────────────────────────── */
  .hm-grain {
    position: absolute;
    border-radius: 40% 55% 50% 45% / 55% 45% 55% 45%;
    background: radial-gradient(60% 60% at 34% 30%, var(--color-hm-earth-200) 0%, var(--color-hm-earth-500) 55%, var(--color-hm-earth-800) 100%);
    box-shadow:
      inset 0 -1px 2px 0 rgb(23 15 9 / 0.7),
      0 2px 5px -2px rgb(0 0 0 / 0.6);
    will-change: transform, opacity;
  }

  /* ── Chispas de impacto ────────────────────────────────────────────── */
  .hm-spark {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    will-change: transform, opacity;
  }

  .hm-spark--coin {
    background: radial-gradient(circle, var(--color-hm-gold-100) 0%, var(--color-hm-gold-500) 55%, transparent 72%);
    box-shadow: 0 0 14px 2px rgb(216 160 41 / 0.7);
  }

  .hm-spark--food {
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 40% 55% 50% 45% / 55% 45% 55% 45%;
    background: radial-gradient(circle, var(--color-hm-earth-100) 0%, var(--color-hm-earth-400) 60%, transparent 75%);
    box-shadow: 0 0 10px 1px rgb(220 192 148 / 0.55);
  }

  /* ── Destello de impacto (inversiones muy grandes) ─────────────────── */
  .hm-fx__layer--flash {
    opacity: 0;
    background: radial-gradient(60% 55% at 50% 42%, rgb(251 233 180 / 0.5) 0%, transparent 70%);
  }

  .hm-fx__layer--flash.is-hard {
    background: radial-gradient(
      70% 65% at 50% 40%,
      rgb(234 191 78 / 0.55) 0%,
      rgb(107 71 16 / 0.22) 45%,
      transparent 72%
    );
  }

  .hm-fx__layer--flash.is-live {
    animation: hm-fx-flash 400ms ease-out both;
  }

  @keyframes hm-fx-flash {
    0% {
      opacity: 0;
    }
    14% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>
