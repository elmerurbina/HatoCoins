---
---

<section class="feed" data-history aria-label="Historial de premios ganados">
  <header class="feed__head">
    <h3 class="hud-label">PREMIOS</h3>
    <span class="feed__stock">
      <b data-history-count>0</b> ganados · <b data-stock-left>0</b> en stock
    </span>
  </header>

  <ul class="feed__list" data-history-list>
    <li class="feed__row is-empty">
      <span class="feed__emoji" aria-hidden="true">🍼</span>
      <span class="feed__text">Todavía no hay premios</span>
      <span class="feed__time">--:--</span>
    </li>
  </ul>
</section>

<style>
  .feed {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    align-content: start;
    padding: 12px 14px;
    background:
      linear-gradient(168deg, rgb(24 42 36 / 0.92) 0%, rgb(11 35 25 / 0.88) 48%, rgb(6 20 15 / 0.95) 100%);
    border: 1px solid rgb(139 161 147 / 0.16);
    border-radius: var(--radius-hud);
    box-shadow: var(--shadow-hud);
    backdrop-filter: blur(8px);
    min-width: 0;
    overflow: hidden;
  }

  .feed__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }
  .feed__head h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-hm-ink-300);
  }
  .feed__stock {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--color-hm-ink-400);
  }
  .feed__stock b { color: var(--color-hm-gold-300); }

  .feed__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 5px;
    max-height: min(38vh, 260px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    align-content: start;
  }

  .feed__row {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 6px 9px;
    border-radius: 10px;
    background: rgb(10 20 17 / 0.55);
    border-left: 2px solid var(--prize-color, var(--color-hm-ink-500));
    animation: hm-rise 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .feed__row.is-empty {
    opacity: 0.4;
    border-left-color: transparent;
    grid-template-columns: 24px minmax(0, 1fr) auto;
  }

  .feed__emoji { font-size: 15px; line-height: 1; }

  .feed__text {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }
  .feed__text b {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 11.5px;
    color: var(--color-hm-ink-100);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .feed__text i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--color-hm-gold-200);
  }

  .feed__time {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--color-hm-ink-400);
    white-space: nowrap;
  }
</style>
