---
/**
 * CustomAmount — entrada manual de cantidad.
 * Acepta enteros positivos: 750, 1.000, 12 500, $1 000, 500 HM.
 * Rechaza vacío, 0, negativos, decimales y texto inválido (ver parseAmount).
 */
---

<div class="custom">
  <label class="custom__label" for="custom-amount">O INGRESA TU CANTIDAD</label>

  <div class="custom__field" data-custom-field>
    <span class="custom__prefix" aria-hidden="true">🪙</span>
    <input
      id="custom-amount"
      class="custom__input"
      type="text"
      inputmode="numeric"
      autocomplete="off"
      spellcheck="false"
      placeholder="750"
      data-action="custom-amount"
      aria-describedby="custom-hint"
    />
    <span class="custom__suffix" aria-hidden="true">HM</span>
  </div>

  <p class="custom__hint" id="custom-hint" data-custom-hint>Cualquier cantidad positiva.</p>
</div>

<style>
  .custom {
    display: grid;
    gap: 7px;
    justify-items: center;
  }

  .custom__label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 12.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-hm-ink-300);
  }

  .custom__field {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 330px;
    padding: 2px 20px 2px 18px;
    border-radius: 18px;
    background: linear-gradient(180deg, #0a1411 0%, #071310 100%);
    border: 2px solid rgb(139 161 147 / 0.24);
    box-shadow:
      inset 0 3px 10px 0 rgb(0 0 0 / 0.7),
      0 0 0 0 rgb(234 191 78 / 0);
    transition:
      border-color 180ms ease,
      box-shadow 220ms ease;
  }

  .custom__field:focus-within {
    border-color: rgb(234 191 78 / 0.85);
    box-shadow:
      inset 0 3px 10px 0 rgb(0 0 0 / 0.7),
      0 0 0 4px rgb(216 160 41 / 0.16),
      0 0 34px -8px rgb(216 160 41 / 0.7);
  }

  .custom__field.is-invalid {
    border-color: rgb(224 122 108 / 0.85);
    box-shadow:
      inset 0 3px 10px 0 rgb(0 0 0 / 0.7),
      0 0 0 4px rgb(168 68 58 / 0.22);
    animation: hm-shake 320ms ease;
  }

  .custom__field.is-valid {
    border-color: rgb(69 167 95 / 0.8);
    box-shadow:
      inset 0 3px 10px 0 rgb(0 0 0 / 0.7),
      0 0 0 4px rgb(69 167 95 / 0.16),
      0 0 30px -10px rgb(69 167 95 / 0.7);
  }

  .custom__prefix {
    font-size: 21px;
    line-height: 1;
    opacity: 0.9;
  }

  .custom__input {
    flex: 1;
    min-width: 0;
    padding: 4px 0;
    border: 0;
    background: transparent;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 32px;
    letter-spacing: 0.01em;
    color: var(--color-hm-gold-100);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .custom__input::placeholder {
    color: rgb(139 161 147 / 0.4);
  }

  .custom__input:focus {
    outline: none;
  }

  .custom__suffix {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.14em;
    color: var(--color-hm-gold-500);
  }

  .custom__hint {
    margin: 0;
    min-height: 1.2em;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-hm-ink-400);
  }

  .custom__hint.is-error {
    color: #e07a6c;
  }

  .custom__hint.is-ok {
    color: var(--color-hm-green-200);
  }
</style>
