---
import Button from '../ui/Button.astro';
import { COPY } from '../../lib/config';

/**
 * ConfirmationModal — último paso antes de registrar la inversión.
 * Todos los textos se rellenan en runtime (importe y categoríaEleidos).
 */
---

<div class="scrim" data-modal="confirm" data-open="false" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="confirm-title">
  <div class="modal-card">
    <div class="hud-panel hud-corners confirm">
      <h3 class="confirm__title" id="confirm-title">{COPY.confirmTitle}</h3>

      <div class="confirm__amount">
        <span class="confirm__coin" aria-hidden="true">🪙</span>
        <span class="confirm__value" data-confirm-amount>0 HM</span>
      </div>

      <p class="confirm__category" data-confirm-category>🪙 HatoCoins</p>

      <p class="confirm__body">{COPY.confirmBody}</p>

      <div class="confirm__actions">
        <Button variant="ghost" size="lg" data-action="cancel" data-fx="cancel-button" id="confirm-cancel">
          {COPY.cancel}
        </Button>
        <Button variant="gold" size="xl" data-action="invest" data-fx="invest-button" id="confirm-invest">
          {COPY.invest}
        </Button>
      </div>

      <p class="confirm__hint">Enter para invertir · Esc para cancelar</p>
    </div>
  </div>
</div>

<style>
  .confirm {
    display: grid;
    justify-items: center;
    gap: 16px;
    padding: 46px 64px 38px;
    min-width: 720px;
    text-align: center;
  }

  .confirm__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 24px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-hm-ink-200);
  }

  .confirm__amount {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .confirm__coin {
    font-size: 62px;
    line-height: 1;
    filter: drop-shadow(0 0 26px rgb(216 160 41 / 0.6));
  }

  .confirm__value {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 76px;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(
      178deg,
      var(--color-hm-gold-100) 0%,
      var(--color-hm-gold-300) 44%,
      var(--color-hm-gold-600) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 34px rgb(216 160 41 / 0.45));
  }

  .confirm__category {
    margin: 0;
    padding: 10px 26px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-hm-purple-200);
    background: rgb(35 22 64 / 0.6);
    border: 1px solid rgb(125 85 196 / 0.45);
  }

  .confirm__body {
    margin: 4px 0 0;
    font-size: 19px;
    font-style: italic;
    color: var(--color-hm-ink-200);
  }

  .confirm__actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 10px;
  }

  .confirm__hint {
    margin: 4px 0 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-hm-ink-500);
  }
</style>
