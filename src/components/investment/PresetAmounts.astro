---
import { PRESET_AMOUNTS } from '../../lib/config';
import { formatAmount } from '../../lib/investments';

/**
 * PresetAmounts — botones grandes de sugerencia de inversión.
 * +500 y +1,000 van destacados: son los botones que más se pulsan en el stand.
 */
const highlighted = new Set<number>([500, 1000]);
---

<div class="presets" role="group" aria-label="Cantidades sugeridas">
  {
    PRESET_AMOUNTS.map((amount) => (
      <button
        type="button"
        class:list={['preset', highlighted.has(amount) && 'preset--hero']}
        data-amount={amount}
        data-action="preset"
        aria-label={`Invertir ${formatAmount(amount)} HatoCoins`}
      >
        <span class="preset__plus" aria-hidden="true">
          +
        </span>
        <span class="preset__value">{formatAmount(amount)}</span>
        <span class="preset__unit">HM</span>
        {highlighted.has(amount) && <span class="preset__flare" aria-hidden="true" />}
      </button>
    ))
  }
</div>

<style>
  .presets {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 12px;
  }

  .preset {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    height: 100px;
    padding: 14px 6px 12px;
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(180deg, #182a24 0%, #0a1411 100%);
    border: 1px solid rgb(139 161 147 / 0.2);
    box-shadow:
      inset 0 1px 0 0 rgb(233 245 236 / 0.08),
      0 3px 0 0 rgb(4 18 13 / 0.9),
      0 12px 24px -14px rgb(0 0 0 / 0.9);
    transition:
      transform 110ms cubic-bezier(0.3, 0, 0.2, 1),
      box-shadow 180ms ease,
      border-color 180ms ease,
      filter 180ms ease;
  }

  .preset:hover {
    filter: brightness(1.15);
    border-color: rgb(234 191 78 / 0.45);
  }

  .preset:active {
    transform: translateY(3px);
    box-shadow:
      inset 0 2px 6px 0 rgb(0 0 0 / 0.6),
      0 0 0 0 rgb(234 191 78 / 0);
  }

  .preset.is-selected {
    border-color: rgb(234 191 78 / 0.9);
    background: linear-gradient(180deg, #2a3a2c 0%, #14211a 100%);
    box-shadow:
      inset 0 1px 0 0 rgb(253 245 218 / 0.2),
      0 0 0 3px rgb(216 160 41 / 0.22),
      0 0 32px -6px rgb(216 160 41 / 0.6);
  }

  .preset__plus {
    position: absolute;
    top: 7px;
    left: 11px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17px;
    color: var(--color-hm-green-300);
    opacity: 0.85;
  }

  .preset__value {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 31px;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-hm-green-50);
    font-variant-numeric: tabular-nums;
  }

  .preset__unit {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--color-hm-ink-400);
  }

  /* ── Botones estrella: 500 y 1000 ─────────────────────────────────── */
  .preset--hero {
    background: linear-gradient(180deg, #2c3d24 0%, #14211a 60%, #0a1411 100%);
    border-color: rgb(234 191 78 / 0.5);
    box-shadow:
      inset 0 1px 0 0 rgb(253 245 218 / 0.16),
      0 3px 0 0 #4a3008,
      0 0 26px -8px rgb(216 160 41 / 0.7),
      0 14px 26px -14px rgb(0 0 0 / 0.9);
  }

  .preset--hero .preset__value {
    font-size: 34px;
    color: var(--color-hm-gold-100);
    text-shadow: 0 0 22px rgb(216 160 41 / 0.5);
  }

  .preset--hero .preset__unit {
    color: var(--color-hm-gold-500);
  }

  .preset--hero .preset__plus {
    color: var(--color-hm-gold-400);
  }

  .preset__flare {
    position: absolute;
    inset: -40% -10%;
    background: linear-gradient(
      104deg,
      transparent 38%,
      rgb(253 245 218 / 0.16) 50%,
      transparent 62%
    );
    transform: translateX(-130%);
    pointer-events: none;
  }

  .preset--hero:hover .preset__flare {
    animation: hm-sheen 780ms ease-out;
  }
</style>
