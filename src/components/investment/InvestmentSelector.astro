---
import Button from '../ui/Button.astro';
import PresetAmounts from './PresetAmounts.astro';
import CustomAmount from './CustomAmount.astro';
import CategorySelector from './CategorySelector.astro';
import { COPY } from '../../lib/config';
---

<!--
  InvestmentSelector — consola de inversión del stand.
  Paso 1: cantidad → Paso 2: categoría (opcional) → Confirmación.
  Ambos pasos viven en el MISMO panel: no hay rutas ni páginas intermedias.
-->
<section class="invest hud-panel hud-corners" data-invest-panel>
  <!-- Paso 1 · Cantidad -->
  <div class="invest__step" data-step="amount">
    <div class="invest__head">
      <h2 class="invest__title">{COPY.amountTitle}</h2>
      <span class="invest__stepper" data-step-dots aria-hidden="true">
        <i class="is-active"></i><i></i>
      </span>
    </div>

    <PresetAmounts />
    <CustomAmount />

    <Button
      variant="primary"
      size="xl"
      class="invest__cta"
      data-action="to-category"
      data-fx="amount-continue"
      id="btn-continue"
      disabled
    >
      {COPY.continue}
    </Button>
  </div>

  <!-- Paso 2 · Categoría (opcional) -->
  <div class="invest__step" data-step="category" hidden>
    <div class="invest__head">
      <h2 class="invest__title">{COPY.whereTitle}</h2>
      <span class="invest__stepper" data-step-dots aria-hidden="true">
        <i></i><i class="is-active"></i>
      </span>
    </div>

    <p class="invest__subtitle">
      {COPY.whereSubtitle} · <strong data-selected-amount>0 HM</strong>
    </p>

    <CategorySelector />

    <div class="invest__actions">
      <Button variant="ghost" size="lg" data-action="back-amount" data-fx="back-button">
        VOLVER
      </Button>
      <Button
        variant="gold"
        size="xl"
        data-action="review"
        data-fx="review-button"
        id="btn-review"
      >
        REVISAR
      </Button>
    </div>
  </div>
</section>

<style>
  .invest {
    display: grid;
    padding: 16px 24px 14px;
    height: 372px;
    align-content: start;
    gap: 12px;
  }

  .invest__step {
    display: grid;
    gap: 12px;
    align-content: start;
    animation: hm-float-in 380ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .invest__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .invest__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 24px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-hm-green-50);
    text-shadow: 0 0 28px rgb(69 167 95 / 0.35);
  }

  .invest__stepper {
    display: inline-flex;
    gap: 7px;
  }

  .invest__stepper i {
    width: 26px;
    height: 6px;
    border-radius: 999px;
    background: rgb(139 161 147 / 0.22);
    transition:
      background 220ms ease,
      box-shadow 220ms ease;
  }

  .invest__stepper i.is-active {
    background: linear-gradient(90deg, #d6a029, #fbe9b4);
    box-shadow: 0 0 14px rgb(234 191 78 / 0.8);
  }

  .invest__subtitle {
    margin: -8px 0 0;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-hm-ink-400);
  }

  .invest__subtitle strong {
    color: var(--color-hm-gold-300);
    font-variant-numeric: tabular-nums;
  }

  .invest__cta {
    margin-top: 2px;
    width: 100%;
  }

  .invest__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 2px;
  }
</style>
