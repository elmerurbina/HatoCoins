---
import '../styles/global.css';
import Brissa from '../components/game/Brissa.astro';
import RifaMachine from '../components/game/RifaMachine.astro';
import InvestmentInput from '../components/game/InvestmentInput.astro';
import PrizeReveal from '../components/game/PrizeReveal.astro';
import PrizeHistory from '../components/game/PrizeHistory.astro';
import OrdenarButton from '../components/game/OrdenarButton.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#04120d" />
    <meta name="description" content="HatoCoins · Rifa de Price Discovery — Ordeña a Brissa y gana premios" />
    <title>HatoCoins · Rifa de Price Discovery</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="stage-frame">
      <main class="stage" data-stage data-phase="idle">
        <div class="cine-bar cine-bar--top" aria-hidden="true"></div>
        <div class="cine-bar cine-bar--bottom" aria-hidden="true"></div>

        <!-- Atmósfera -->
        <div class="layer layer--grid" aria-hidden="true"></div>
        <div class="layer layer--aurora" aria-hidden="true"></div>
        <div class="layer layer--dust" aria-hidden="true"></div>
        <div class="layer layer--vignette" aria-hidden="true"></div>

        <!-- Brissa como fondo -->
        <div class="brissa-bg" aria-hidden="true">
          <Brissa state="idle" size={760} />
        </div>

        <!-- Contenedor de confeti -->
        <div class="confetti" data-confetti aria-hidden="true"></div>

        <header class="game-header">
          <div class="game-header__brand">
            <span class="game-header__mark" aria-hidden="true">
              <svg viewBox="0 0 44 44" width="34" height="34" focusable="false">
                <defs>
                  <linearGradient id="hm-mark" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#7fca8d" />
                    <stop offset="100%" stop-color="#2a8248" />
                  </linearGradient>
                </defs>
                <rect x="2" y="2" width="40" height="40" rx="13" fill="url(#hm-mark)" opacity="0.22" />
                <rect x="2.75" y="2.75" width="38.5" height="38.5" rx="12.5" fill="none" stroke="#7fca8d" stroke-opacity="0.7" stroke-width="1.5" />
                <path d="M13 30c0-7 4-13 9-13s9 6 9 13" fill="none" stroke="#c2e6c8" stroke-width="2.6" stroke-linecap="round" />
                <path d="M17 30h10" stroke="#eabf4e" stroke-width="2.6" stroke-linecap="round" />
                <circle cx="22" cy="24" r="2.4" fill="#eabf4e" />
              </svg>
            </span>
            <span class="game-header__names">
              <b class="game-header__wordmark">HATOMASTER</b>
              <i class="game-header__tag">Rifa de Price Discovery</i>
            </span>
          </div>

          <div class="game-header__center">
            <h1 class="game-header__headline">ORDEÑA A BRISSA</h1>
            <p class="game-header__quote">Cada inversión es una oportunidad</p>
          </div>

          <div class="game-header__status">
            <span class="game-header__pill">
              <span class="game-header__dot" aria-hidden="true"></span>
              <span data-status-text>EN VIVO</span>
            </span>
            <span class="game-header__invs" data-investment-count>0 participaciones</span>
          </div>
        </header>

        <section class="scene">
          <div class="scene__left">
            <button
              class="scene__brissa"
              type="button"
              data-action="brissa"
              aria-label="Ver el premio de Brissa"
            >
              <span class="scene__nameplate">
                <b>BRISSA</b>
                <i>la vaca de la fortuna</i>
              </span>
              <span class="scene__cow" data-cow>
                <Brissa state="idle" size={300} />
                <span class="scene__puddle" aria-hidden="true"></span>
              </span>
              <span class="scene__peek" data-peek aria-hidden="true">
                <svg viewBox="0 0 24 24" width="13" height="13" focusable="false">
                  <path
                    d="M2 12s3.8-6.5 10-6.5S22 12 22 12s-3.8 6.5-10 6.5S2 12 2 12Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  />
                  <circle cx="12" cy="12" r="2.6" fill="currentColor" />
                </svg>
                <span data-peek-text>Toca a Brissa</span>
              </span>
            </button>
          </div>

          <div class="scene__center">
            <InvestmentInput />
            <OrdenarButton />
            <PrizeReveal />
          </div>

          <aside class="scene__side">
            <PrizeHistory />
          </aside>
        </section>

        <RifaMachine />

        <div class="stats-bar">
          <div class="stat">
            <span class="stat__label">Invertido</span>
            <span class="stat__value" data-stat-total-value>0 HM</span>
          </div>
          <div class="stat">
            <span class="stat__label">Ordeñadas</span>
            <span class="stat__value" data-stat-count-value>0</span>
          </div>
          <div class="stat">
            <span class="stat__label">Mejor premio</span>
            <span class="stat__value stat__value--sm" data-stat-best-value>—</span>
          </div>
          <div class="stat">
            <span class="stat__label">Stock</span>
            <span class="stat__value" data-stat-stock-value>0</span>
          </div>
        </div>

        <div class="instructions">
          <kbd>1</kbd>–<kbd>8</kbd> monto · <kbd>Enter</kbd> ordeñar ·
          <kbd>Esc</kbd> limpiar · <kbd>R</kbd> reiniciar
        </div>

        <div class="hold" data-reset-hold data-active="false">
          <span class="hold__ring" data-hold-ring aria-hidden="true"></span>
          <span class="hold__label">Mantén para reiniciar</span>
        </div>

        <div class="toast" data-toast data-kind="error" data-visible="false" role="status" aria-live="polite"></div>
      </main>
    </div>

    <!-- Visor de premio: al tocar a Brissa se abre la imagen grande del premio -->
    <div class="prize-view" data-prize-view hidden>
      <button
        class="prize-view__scrim"
        type="button"
        data-action="prize-view-close"
        tabindex="-1"
        aria-label="Cerrar"
      ></button>
      <figure
        class="prize-view__card"
        role="dialog"
        aria-modal="true"
        aria-label="Premio obtenido"
        data-prize-view-card
      >
        <span class="prize-view__tier" data-prize-view-tier>Premio</span>
        <figure class="prize-view__figure">
          <span class="prize-view__halo" aria-hidden="true"></span>
          <span class="prize-view__fallback" data-prize-view-fallback aria-hidden="true"></span>
          <img
            class="prize-view__image"
            data-prize-view-image
            src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
            alt=""
            width="260"
            height="260"
          />
        </figure>
        <figcaption class="prize-view__meta">
          <b class="prize-view__name" data-prize-view-name>—</b>
          <span class="prize-view__invest" data-prize-view-meta></span>
        </figcaption>
        <button class="prize-view__close" type="button" data-action="prize-view-close">
          Cerrar
        </button>
      </figure>
    </div>

    <script>
      import '../scripts/game';
    </script>
  </body>
</html>

<style>
  /* ══ Capa de atmósfera ═══════════════════════════════════════════ */
  /* `inset: -10%` en vez de 0: las capas se animan (deriva y polvo), y
     con inset 0 el `overflow: clip` del stage muerde los bordes. */
  .layer { position: absolute; inset: -10%; pointer-events: none; }

  .layer--grid {
    background-image:
      linear-gradient(rgb(139 161 147 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(139 161 147 / 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 60% at 50% 40%, #000 0%, transparent 85%);
  }

  /* Auroras que derivan: quita la sensación de "imagen fija" */
  .layer--aurora {
    background:
      radial-gradient(48% 36% at 22% 24%, rgb(69 167 95 / 0.2) 0%, transparent 70%),
      radial-gradient(42% 32% at 78% 30%, rgb(165 131 224 / 0.18) 0%, transparent 72%),
      radial-gradient(40% 30% at 50% 82%, rgb(85 166 198 / 0.14) 0%, transparent 72%);
    animation: aurora-drift 18s ease-in-out infinite alternate;
  }

  /* Motas de polvo flotantes */
  .layer--dust {
    background-image:
      radial-gradient(2px 2px at 12% 24%, rgb(253 245 218 / 0.7) 50%, transparent),
      radial-gradient(2px 2px at 28% 68%, rgb(127 202 141 / 0.6) 50%, transparent),
      radial-gradient(1.5px 1.5px at 44% 14%, rgb(253 245 218 / 0.5) 50%, transparent),
      radial-gradient(2px 2px at 61% 82%, rgb(234 191 78 / 0.55) 50%, transparent),
      radial-gradient(1.5px 1.5px at 76% 36%, rgb(201 178 240 / 0.55) 50%, transparent),
      radial-gradient(2px 2px at 88% 64%, rgb(253 245 218 / 0.5) 50%, transparent),
      radial-gradient(1.5px 1.5px at 34% 44%, rgb(127 202 141 / 0.45) 50%, transparent),
      radial-gradient(2px 2px at 66% 22%, rgb(85 166 198 / 0.5) 50%, transparent);
    animation: dust-rise 14s linear infinite;
  }

  .layer--vignette {
    background:
      radial-gradient(130% 100% at 50% 45%, transparent 52%, rgb(4 12 9 / 0.6) 100%),
      linear-gradient(0deg, rgb(4 12 9 / 0.4) 0%, transparent 22%);
  }

  .brissa-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    opacity: 0.14;
    pointer-events: none;
  }
  .brissa-bg :global(.brissa) {
    width: min(760px, 130vw);
    height: auto;
    aspect-ratio: 1;
    animation: bg-drift 24s ease-in-out infinite alternate;
  }
  .brissa-bg :global(.brissa__svg) { animation: none; }

  /* ══ Confeti ═════════════════════════════════════════════════════ */
  .confetti {
    position: absolute;
    z-index: 70;
    left: 50%;
    top: 44%;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .confetti :global(.confetti__bit) {
    position: absolute;
    width: 9px;
    height: 14px;
    border-radius: 2px;
    opacity: 0;
    animation: confetti-fly var(--dur, 1200ms) cubic-bezier(0.2, 0.7, 0.4, 1) var(--delay, 0ms) both;
  }

  /* ══ Header ═══════════════════════════════════════════════════════ */
  .game-header {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    padding: 10px clamp(12px, 3vw, 30px);
    min-width: 0;
  }
  .game-header__brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .game-header__mark { flex: none; display: grid; place-items: center; }
  .game-header__names { display: grid; min-width: 0; line-height: 1.1; }
  .game-header__wordmark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(15px, 2.6vw, 24px);
    letter-spacing: 0.1em;
    color: var(--color-hm-green-50);
    white-space: nowrap;
  }
  .game-header__tag {
    font-style: normal;
    font-size: clamp(8px, 1.4vw, 10.5px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-hm-ink-300);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .game-header__center { text-align: center; min-width: 0; }
  .game-header__headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(18px, 4.4vw, 40px);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: linear-gradient(
      178deg,
      var(--color-hm-gold-100) 0%,
      var(--color-hm-gold-300) 44%,
      var(--color-hm-gold-600) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 18px rgb(216 160 41 / 0.28));
    white-space: nowrap;
  }
  .game-header__quote {
    margin: 2px 0 0;
    font-size: clamp(9px, 1.6vw, 14px);
    font-style: italic;
    color: var(--color-hm-ink-200);
    white-space: nowrap;
  }
  .game-header__status {
    justify-self: end;
    display: grid;
    justify-items: end;
    gap: 4px;
    min-width: 0;
  }
  .game-header__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgb(6 20 15 / 0.6);
    border: 1px solid rgb(139 161 147 / 0.2);
    font-size: clamp(8px, 1.4vw, 11px);
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-hm-ink-200);
    max-width: 100%;
  }
  .game-header__pill [data-status-text] {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .game-header__dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-hm-green-300);
    box-shadow: 0 0 12px var(--color-hm-green-300);
    animation: hm-pulse-glow 2.4s ease-in-out infinite;
  }
  .game-header__invs {
    font-family: var(--font-mono);
    font-size: clamp(8px, 1.4vw, 12px);
    color: var(--color-hm-ink-300);
    white-space: nowrap;
  }

  /* ══ Escena ══════════════════════════════════════════════════════ */
  .scene {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, clamp(200px, 22vw, 300px)) minmax(0, 1fr) minmax(0, clamp(210px, 24vw, 290px));
    align-items: center;
    gap: clamp(10px, 1.6vw, 20px);
    padding: 0 clamp(12px, 3vw, 30px);
    min-width: 0;
  }
  .scene__left, .scene__center, .scene__side { min-width: 0; display: grid; align-content: center; }
  .scene__left { justify-items: center; }
  .scene__center { justify-items: center; gap: 10px; }
  .scene__center > :global(*:first-child) { width: 100%; max-width: 360px; }

  .scene__brissa {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 100%;
    padding: 10px 8px 14px;
    border-radius: 18px;
    background: none;
    border: 1px solid transparent;
    transition:
      background 260ms ease,
      border-color 260ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /*(cursor pointer) heredado de button en global.css */
  .scene__brissa:hover,
  .scene__brissa:focus-visible {
    background: rgb(127 202 141 / 0.06);
    border-color: rgb(127 202 141 / 0.22);
  }
  .scene__brissa:focus-visible { outline: 2px solid rgb(234 191 78 / 0.75); outline-offset: 3px; }
  .scene__brissa:active { transform: translateY(1px) scale(0.985); }
  .scene__brissa[data-has-prize='true'] {
    background: rgb(127 202 141 / 0.08);
    border-color: rgb(216 160 41 / 0.34);
    animation: cow-ready 2.8s ease-in-out infinite;
  }
  @keyframes cow-ready {
    0%, 100% { box-shadow: 0 0 0 0 rgb(216 160 41 / 0.28); }
    50% { box-shadow: 0 0 0 9px rgb(216 160 41 / 0); }
  }
  .scene__brissa.is-bouncing { animation: cow-bounce 620ms cubic-bezier(0.28, 1.4, 0.4, 1); }
  @keyframes cow-bounce {
    0%, 100% { transform: translateY(0) scale(1); }
    22% { transform: translateY(-16px) scale(1.04, 0.95); }
    48% { transform: translateY(2px) scale(0.97, 1.04); }
    72% { transform: translateY(-5px) scale(1.01, 0.99); }
  }

  .scene__cow { position: relative; display: grid; justify-items: center; }
  .scene__brissa :global(.brissa) { width: min(100%, clamp(180px, 20vw, 300px)); height: auto; aspect-ratio: 1; }

  .scene__peek {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgb(5 18 13 / 0.86);
    border: 1px solid rgb(127 202 141 / 0.24);
    color: var(--color-hm-ink-200);
    font-size: 11px;
    letter-spacing: 0.04em;
    opacity: 0.75;
    transition: opacity 240ms ease;
  }
  .scene__brissa:hover .scene__peek,
  .scene__brissa:focus-visible .scene__peek { opacity: 1; }
  .scene__peek svg { color: var(--color-hm-gold); flex: none; }

  /* ══ Visor de premio ═════════════════════════════════════════════ */
  .prize-view {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: clamp(14px, 4vw, 32px);
  }
  .prize-view[hidden] { display: none; }

  .prize-view__scrim {
    position: absolute;
    inset: 0;
    background: rgb(2 8 6 / 0.82);
    backdrop-filter: blur(10px) saturate(0.7);
    animation: pv-fade 260ms ease both;
    cursor: zoom-out;
  }
  @keyframes pv-fade { from { opacity: 0; } to { opacity: 1; } }

  .prize-view__card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 12px;
    width: min(100%, 380px);
    max-height: calc(100dvh - clamp(28px, 8vw, 64px));
    margin: 0;
    padding: clamp(18px, 4vw, 26px);
    overflow: auto;
    overscroll-behavior: contain;
    text-align: center;
    background:
      linear-gradient(168deg, rgb(26 46 38 / 0.97) 0%, rgb(11 34 25 / 0.96) 50%, rgb(5 18 13 / 0.98) 100%);
    border: 1px solid rgb(216 160 41 / 0.3);
    border-radius: 22px;
    box-shadow: 0 34px 90px -26px rgb(0 0 0 / 0.92), inset 0 1px 0 0 rgb(233 245 236 / 0.08);
    animation: pv-pop 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes pv-pop {
    from { opacity: 0; transform: translateY(26px) scale(0.9); }
    to { opacity: 1; transform: none; }
  }

  .prize-view__tier {
    padding: 4px 12px;
    border-radius: 999px;
    background: rgb(127 202 141 / 0.12);
    border: 1px solid rgb(127 202 141 / 0.28);
    color: var(--color-hm-ink-100);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .prize-view__figure {
    position: relative;
    display: grid;
    place-items: center;
    width: min(72vw, 260px);
    aspect-ratio: 1;
    margin: 0;
  }
  .prize-view__halo {
    position: absolute;
    inset: -14%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(127 202 141 / 0.24) 0%, transparent 68%);
    animation: pv-halo 3.4s ease-in-out infinite;
  }
  @keyframes pv-halo {
    0%, 100% { transform: scale(1); opacity: 0.75; }
    50% { transform: scale(1.12); opacity: 1; }
  }
  .prize-view__image {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 16px 30px rgb(0 0 0 / 0.6));
    animation: pv-float 4.2s ease-in-out infinite;
  }
  /* Si una imagen falla, se muestra el emoji del nivel en vez de un hueco. */
  .prize-view__fallback {
    position: absolute;
    display: none;
    font-size: clamp(84px, 26vw, 150px);
    line-height: 1;
  }
  .prize-view__figure[data-image='error'] .prize-view__fallback { display: block; }
  .prize-view__figure[data-image='error'] .prize-view__image { visibility: hidden; }
  @keyframes pv-float {
    0%, 100% { transform: translateY(0) rotate(-0.6deg); }
    50% { transform: translateY(-9px) rotate(0.6deg); }
  }

  .prize-view__meta { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; min-width: 0; }
  .prize-view__name { font-size: 19px; line-height: 1.2; color: var(--color-hm-ink-50); }
  .prize-view__invest { font-size: 12px; color: var(--color-hm-ink-300); }

  .prize-view__close {
    margin-top: 2px;
    padding: 10px 22px;
    border-radius: 999px;
    background: rgb(127 202 141 / 0.14);
    border: 1px solid rgb(127 202 141 / 0.3);
    color: var(--color-hm-ink-100);
    font-size: 13px;
    letter-spacing: 0.06em;
    transition: background 200ms ease, transform 200ms ease;
  }
  .prize-view__close:hover { background: rgb(127 202 141 / 0.24); }
  .prize-view__close:active { transform: scale(0.96); }

  .scene__puddle {
    position: absolute;
    bottom: -2%;
    left: 50%;
    width: 62%;
    height: 12px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(253 245 218 / 0.22), transparent);
    filter: blur(3px);
  }

  .scene__nameplate {
    display: grid;
    justify-items: center;
    gap: 0;
    padding: 4px 16px 5px;
    border-radius: 999px;
    background: rgb(6 20 15 / 0.72);
    border: 1px solid rgb(165 131 224 / 0.35);
    margin-bottom: 6px;
    max-width: 100%;
  }
  .scene__nameplate b {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(13px, 2.2vw, 19px);
    letter-spacing: 0.24em;
    color: var(--color-hm-purple-200);
  }
  .scene__nameplate i {
    font-style: normal;
    font-size: clamp(7.5px, 1.2vw, 9.5px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-hm-ink-400);
    white-space: nowrap;
  }

  /* ══ Stats ═══════════════════════════════════════════════════════ */
  .stats-bar {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(8px, 1.4vw, 18px);
    padding: 10px clamp(12px, 3vw, 30px);
    min-width: 0;
  }
  .stat { display: grid; gap: 2px; min-width: 0; }
  .stat__label {
    font-size: clamp(7.5px, 1.2vw, 10px);
